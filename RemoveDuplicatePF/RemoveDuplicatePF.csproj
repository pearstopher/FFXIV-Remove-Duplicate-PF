<?xml version="1.0" encoding="utf-8"?>
<!-- The Dalamud.NET.Sdk version is set in global.json (msbuild-sdks), where Dependabot keeps it up to date (#14). -->
<Project Sdk="Dalamud.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\RemoveDuplicatePF.Core\RemoveDuplicatePF.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Local builds use this. Releases override it from the tag (v1.2.3 -> 1.2.3.0), see .github/workflows/release.yml. -->
    <Version>1.0.0.0</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager) -->
    <Author>pearstopher</Author>
    <Name>Remove Duplicate PF</Name>
    <Punchline>Collapses duplicate Party Finder listings into one.</Punchline>
    <Description>Combines duplicate Party Finder listings (ads that start with the same 30 characters) into one, marks it with a coloured [N] count, and shows the number combined in the Party Finder title. No settings: enable it and it works.</Description>
    <RepoUrl>https://github.com/pearstopher/FFXIV-Remove-Duplicate-PF</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/pearstopher/FFXIV-Remove-Duplicate-PF/main/images/icon.png</IconUrl>
    <Tags>party finder;duplicates;filter</Tags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plugin icon: 512x512 square PNG. Dalamud shows a dev plugin's icon from images/icon.png next to its DLL. -->
    <Content Include="..\images\icon.png" Link="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
