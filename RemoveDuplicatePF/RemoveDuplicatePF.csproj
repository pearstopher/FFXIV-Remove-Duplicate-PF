<?xml version="1.0" encoding="utf-8"?>
<!-- The Dalamud.NET.Sdk version is set in global.json (msbuild-sdks), where Dependabot keeps it up to date (#14). -->
<Project Sdk="Dalamud.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\RemoveDuplicatePF.Core\RemoveDuplicatePF.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Local builds use this. Releases override it from the tag (v1.2.3 -> 1.2.3.0), see .github/workflows/release.yml. -->
    <Version>1.1.2.0</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager) -->
    <Author>Ane Mora</Author>
    <Name>Remove Duplicate PF</Name>
    <Punchline>Hide duplicate Party Finder ads. Each repeated listing shows once, with a count.</Punchline>
    <!-- &#10;&#10; puts a blank line before the last sentence in the plugin installer (#66). -->
    <Description>This plugin removes duplicate Party Finder listings. Entries with duplicates are shown once and are marked with a count [n] representing the number of copies that were found. The total number of duplicate entries is shown in the title bar.&#10;&#10;This plugin has no settings.</Description>
    <RepoUrl>https://github.com/pearstopher/FFXIV-Remove-Duplicate-PF</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/pearstopher/FFXIV-Remove-Duplicate-PF/main/images/icon.png</IconUrl>
    <Tags>party finder;pf;duplicates;duplicate;hide;filter;spam;ads;listings</Tags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plugin icon: 512x512 square PNG. Dalamud shows a dev plugin's icon from images/icon.png next to its DLL. -->
    <Content Include="..\images\icon.png" Link="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
